---
const { title = 's. shashwat', description = 'Notes, fragments, and things worth keeping.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — s. shashwat</title>
	</head>
	<body>
		<div class="grain" aria-hidden="true"></div>

		<header class="site-header">
			<div class="photo-switcher" aria-label="A tiny photograph archive">
    <button class="photo-arrow photo-prev" type="button" aria-label="Previous photograph">‹</button>

    <button class="photo-frame" type="button" aria-label="Show next photograph">
        <img src="/photos/photo-01.jpg" alt="Photograph 1 of 3" />
    </button>

    <button class="photo-arrow photo-next" type="button" aria-label="Next photograph">›</button>
</div>

			<nav aria-label="Main navigation">
				<a class:list-active={currentPath === '/'} href="/">index</a>
				<a class:list-active={currentPath === '/library/'} href="/library/">library</a>
				<a class:list-active={currentPath === '/marginalia/'} href="/marginalia/">marginalia</a>
			</nav>
		</header>
	
		
<script>
    const photos = [
        '/photos/photo-01.jpg',
        '/photos/photo-02.jpg',
        '/photos/photo-03.jpg',
    ];

    const frame = document.querySelector<HTMLImageElement>('.photo-frame img');
    const previous = document.querySelector('.photo-prev');
    const next = document.querySelector('.photo-next');

    let current = 0;

    function showPhoto(index: number) {
        if (!frame) return;

        current = (index + photos.length) % photos.length;
        frame.src = photos[current];
        frame.alt = `Photograph ${current + 1} of ${photos.length}`;
    }

    previous?.addEventListener('click', () => showPhoto(current - 1));
    next?.addEventListener('click', () => showPhoto(current + 1));
    frame?.parentElement?.addEventListener('click', () => showPhoto(current + 1));
</script>


		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Fira+Mono:wght@400;500;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Overpass+Mono:wght@300..700&family=Patrick+Hand&family=Sono:wght,MONO@200..800,1&family=Yusei+Magic&family=Yuyu&display=swap');
	
	:root {
		--ink: #e9e6dc;
		--muted: #969891;
		--faint: #5f645f;
		--line: rgba(233, 230, 220, 0.15);
		--accent: #9DBFE3;
		--deep: #151817;
		--panel: #1c201e;
		--serif: 'Instrument Serif', Georgia, serif;
        --body: 'Yusei Magic', 'Trebuchet MS', sans-serif;
	}

	* { box-sizing: border-box; }

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--deep);
		color: var(--ink);
		font-family: var(--body);
		font-size: 13px;
		letter-spacing: 0.02em;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.grain {
		position: fixed;
		inset: 0;
		pointer-events: none;
		opacity: 0.055;
		z-index: 5;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
	}

	.site-header {
		width: min(100% - 64px, 1320px);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.site-header {
		height: 96px;
		border-bottom: 1px solid var(--line);
	}

	.wordmark {
		font-family: var(--serif);
		font-size: 23px;
		letter-spacing: -0.02em;
		transition: color 180ms ease;
	}

	.wordmark:hover {
		color: var(--accent);
	}

	.wordmark-dot {
		color: var(--accent);
	}

	nav {
		display: flex;
		gap: clamp(18px, 4vw, 62px);
		margin-left: 8vw;
	}

	nav a {
		color: var(--muted);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		position: relative;
		transition: color 180ms ease;
	}

	nav a::after {
		content: '';
		position: absolute;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent);
		left: 50%;
		bottom: -12px;
		transform: translateX(-50%) scale(0);
		transition: transform 180ms ease;
	}

	nav a:hover,
	nav a.list-active {
		color: var(--ink);
	}

	nav a.list-active::after,
	nav a:hover::after {
		transform: translateX(-50%) scale(1);
	}

	main {
		width: min(100% - 64px, 1320px);
		margin: 0 auto;
	}

	.eyebrow {
		color: var(--accent);
		font-size: 10px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	@media (max-width: 620px) {
		.site-header,
		main {
			width: min(100% - 36px, 1320px);
		}

		.site-header {
			height: 78px;
		}

		nav {
			gap: 13px;
			margin-left: 0;
		}

		nav a {
			font-size: 9px;
			letter-spacing: 0.1em;
		}
	}

	

/* Tiny monochrome photograph switcher */
.photo-switcher {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
}

.photo-frame {
    display: block;
    width: 112px;
    height: 58px;
    padding: 0;
    overflow: hidden;
    border: none;
    background: #151817;
    cursor: pointer;
}

.photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: auto;
    opacity: 0.82;
    transition: opacity 180ms ease;
}

.photo-frame:hover img {
    opacity: 1;
}

.photo-arrow {
    display:none;
}

.photo-arrow:hover {
    color: var(--accent);
}

.photo-arrow:focus-visible,
.photo-frame:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
}

@media (max-width: 620px) {
    .photo-frame {
        width: 72px;
        height: 40px;
    }

    .photo-arrow {
        font-size: 19px;
    }

    .photo-switcher {
        gap: 3px;
    }
}
</style>