---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = await getCollection('marginalia');

const sortedEntries = [...entries].reverse();
---

<SiteLayout
	title="marginalia"
	description="Loose fragments, pictures, and things kept by s. shashwat."
>
	<section class="marginalia-heading">
		<div>
			<h1>marginalia<span>.</span></h1>
		</div>

		<p>
			who even am i without my collection of almost-nothings
		</p>
	</section>

	<section class="fragment-grid">
		{sortedEntries.map(async (entry, index) => {
			const { Content } = await render(entry);

			if (entry.data.type === 'image') {
				return (
					<article class={`fragment image-card image-${index}`}>
						<div class="image-frame">
							{entry.data.image && (
								<img
									src={entry.data.image}
									alt={entry.data.title}
									loading="lazy"
								/>
							)}

							<div class="image-caption">
								<h2>{entry.data.title}</h2>

								<div class="entry-body">
									<Content />
								</div>
							</div>
						</div>
					</article>
				);
			}

			if (entry.data.type === 'quote') {
				return (
					<article class={`fragment quote-card quote-${index}`}>
						<div class="quote-frame">
							<div class="quote-caption">
								<h2>{entry.data.title}</h2>

								<div class="entry-body">
									<Content />
								</div>
							</div>
						</div>
					</article>
				);
			}

			if (entry.data.type === 'link') {
				return (
					<article class={`fragment note-card link-card link-${index}`}>
						<div class="card-label">
							<span class="label-dot"></span>
							<span>LINK / {String(index + 1).padStart(2, '0')}</span>
						</div>

						<h2>{entry.data.title}</h2>

						<div class="entry-body">
							<Content />
						</div>

						{entry.data.link && (
							<a
								class="external-link"
								href={entry.data.link}
								target="_blank"
								rel="noreferrer"
							>
								open ↗
							</a>
						)}
					</article>
				);
			}

			return (
				<article class={`fragment note-card note-${index}`}>
					<div class="card-label">
						<span class="label-dot"></span>
						<span>NOTE TO SELF / {String(index + 1).padStart(2, '0')}</span>
					</div>

					<h2>{entry.data.title}</h2>

					<div class="entry-body">
						<Content />
					</div>
				</article>
			);
		})}
	</section>
</SiteLayout>

<style>
	.marginalia-heading {
		min-height: 43vh;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding: 60px 0 78px;
		border-bottom: 1px solid var(--line);
	}

	.marginalia-heading h1 {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(75px, 13vw, 170px);
		line-height: .78;
		letter-spacing: -.05em;
		margin: 31px 0 0 -.05em;
	}

	.marginalia-heading h1 span {
		color: var(--accent);
	}

	.marginalia-heading > p {
		color: var(--muted);
		line-height: 1.8;
		font-size: 13px;
		margin-bottom: 5px;
	}

	.fragment-grid {
		padding: 86px 7% 30px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 110px 10%;
		align-items: start;
	}

	.fragment {
		margin: 0;
		transition:
			transform 380ms cubic-bezier(.2, .8, .2, 1),
			box-shadow 380ms ease;
	}

	/* IMAGE */

	.image-card {
		width: 100%;
	}

	.image-card:hover {
		transform: rotate(-1.2deg) translateY(-4px);
	}

	.image-frame {
		background: var(--panel);
		border: 1px solid var(--line);
		padding: 16px;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
	}

	.image-frame img {
		display: block;
		width: 100%;
		height: auto;
		filter: saturate(.7) contrast(1.04);
		transition:
			filter 400ms ease,
			transform 400ms ease;
	}

	.image-card:hover .image-frame img {
		filter: saturate(.95) contrast(1);
	}

	.image-caption {
		padding: 28px 8px 16px;
	}

	.image-caption h2,
.quote-caption h2 {
	font-family: var(--serif);
	font-weight: 400;
	font-size: 28px;
	line-height: 1.1;
	letter-spacing: -.02em;
	color: var(--text);
	margin: 0 0 18px;
}
	}

	/* QUOTE */

	.quote-card {
		width: 100%;
	}

	.quote-card:hover {
		transform: rotate(1.2deg) translateY(-4px);
	}

	.quote-frame {
		background: var(--panel);
		border: 1px solid var(--line);
		padding: 34px;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
	}

	.quote-caption {
		padding: 0 8px 8px;
	}

	/* SHARED BODY */

	.entry-body {
		color: var(--muted);
		font-family: var(--sans);
		font-size: 12px;
		line-height: 1.7;
	}

	.entry-body p {
		margin: 0 0 18px;
	}

	.entry-body p:last-child {
		margin-bottom: 0;
	}

	/* SMALL CARD LABEL */

	.card-label {
		display: flex;
		align-items: center;
		gap: 9px;
		color: var(--accent);
		font-family: var(--sans);
		font-size: 9px;
		font-weight: 500;
		letter-spacing: .15em;
		text-transform: uppercase;
	}

	.label-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent);
		flex: 0 0 auto;
	}

	/* NOTE */

	.note-card {
		background: var(--panel);
		border: 1px solid var(--line);
		padding: 34px;
		transition:
			transform 380ms cubic-bezier(.2, .8, .2, 1),
			box-shadow 380ms ease;
	}

	.note-card:hover {
		transform: rotate(1.2deg) translateY(-4px);
	}

	.note-card h2 {
		font-family: var(--serif);
		font-size: 27px;
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -.02em;
		color: var(--text);
		margin: 30px 0 14px;
	}

	.note-card .entry-body {
		font-family: var(--sans);
		font-size: 12px;
		line-height: 1.7;
	}

	/* LINK */

	.link-card:hover {
		transform: rotate(-1deg) translateY(-4px);
	}

	.external-link {
		display: inline-block;
		color: var(--accent);
		font-family: var(--sans);
		font-size: 9px;
		font-weight: 500;
		letter-spacing: .13em;
		text-transform: uppercase;
		margin-top: 28px;
	}

	/* LARGE IMAGE */

	.image-2 {
		grid-column: 1 / -1;
		width: 61%;
		justify-self: center;
	}

	@media (max-width: 620px) {
		.marginalia-heading {
			min-height: 40vh;
			display: block;
			padding-top: 90px;
		}

		.marginalia-heading > p {
			margin-top: 35px;
		}

		.fragment-grid {
			display: block;
			padding: 62px 0 20px;
		}

		.fragment {
			margin-bottom: 75px;
		}

		.image-2 {
			width: 100%;
		}

		.note-card {
			padding: 27px;
		}

		.note-card .entry-body {
			font-size: 12px;
		}

		.quote-frame {
			padding: 27px;
		}

		.quote-caption {
			padding: 0 4px 4px;
		}

		.image-caption h2,
		.quote-caption h2 {
			font-size: 38px;
		}
	}
</style>