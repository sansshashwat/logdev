---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entries = await getCollection('marginalia');

entries.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<SiteLayout
	title="marginalia"
	description="Things worth keeping."
>
	<section class="marginalia">
		<header class="page-heading">
			<p class="eyebrow">the things I kept</p>
			<h1>marginalia<span>.</span></h1>
		</header>

		<div class="scrapbook">
			{entries.map((entry, index) => (
				<article class={`scrap ${entry.data.type}`}>
					{entry.data.image && (
						<img
							src={entry.data.image}
							alt={entry.data.title}
							loading="lazy"
						/>
					)}

					{entry.data.type === 'quote' && (
						<div class="quote-mark">“</div>
					)}

					{entry.data.description && (
						<div class="scrap-text">
							<p>{entry.data.description}</p>
						</div>
					)}

					{entry.data.link && (
						<a
							class="scrap-link"
							href={entry.data.link}
							target="_blank"
							rel="noreferrer"
						>
							open ↗
						</a>
					)}

					<div class="scrap-footer">
						<span>{entry.data.title}</span>
						<span>
							{entry.data.date.toLocaleDateString('en-GB', {
								day: '2-digit',
								month: '2-digit',
								year: '2-digit',
							})}
						</span>
					</div>
				</article>
			))}
		</div>
	</section>
</SiteLayout>

<style>
	.marginalia {
		padding: 80px 0 140px;
	}

	.page-heading {
		margin-bottom: 100px;
	}

	.page-heading h1 {
		font-family: var(--serif);
		font-size: clamp(70px, 13vw, 170px);
		font-weight: 400;
		line-height: 0.8;
		letter-spacing: -0.05em;
		margin: 30px 0 0;
	}

	.page-heading h1 span {
		color: var(--accent);
	}

	.scrapbook {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 70px 35px;
		align-items: start;
	}

	.scrap {
		position: relative;
		grid-column: span 4;
		padding: 22px;
		border: 1px solid var(--line);
		background: var(--surface);
		transition:
			transform 300ms ease,
			border-color 300ms ease;
	}

	.scrap:hover {
		transform: translateY(-8px) rotate(-1deg);
		border-color: var(--faint);
	}

	.scrap:nth-child(3n + 2) {
		transform: rotate(1.2deg);
	}

	.scrap:nth-child(3n + 2):hover {
		transform: translateY(-8px) rotate(0deg);
	}

	.scrap:nth-child(3n) {
		transform: rotate(-0.8deg);
	}

	.scrap:nth-child(3n):hover {
		transform: translateY(-8px) rotate(-1.8deg);
	}

	.scrap.image {
		grid-column: span 5;
	}

	.scrap.quote {
		grid-column: span 4;
		padding: 35px;
	}

	.scrap.note {
		grid-column: span 4;
	}

	.scrap.link {
		grid-column: span 3;
	}

	.scrap img {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 22px;
	}

	.quote-mark {
		font-family: var(--serif);
		font-size: 70px;
		line-height: 0.5;
		margin-bottom: 25px;
		color: var(--accent);
	}

	.scrap-text {
		color: var(--ink);
		font-family: var(--serif);
		font-size: 20px;
		line-height: 1.45;
	}

	.scrap.note .scrap-text,
	.scrap.link .scrap-text {
		font-family: inherit;
		font-size: 13px;
		line-height: 1.8;
		color: var(--muted);
	}

	.scrap-link {
		display: inline-block;
		margin-top: 25px;
		color: var(--accent);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	.scrap-footer {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		margin-top: 25px;
		padding-top: 12px;
		border-top: 1px solid var(--line);
		color: var(--faint);
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	@media (max-width: 800px) {
		.scrapbook {
			grid-template-columns: repeat(6, 1fr);
			gap: 45px 20px;
		}

		.scrap,
		.scrap.image,
		.scrap.quote,
		.scrap.note,
		.scrap.link {
			grid-column: span 3;
		}
	}

	@media (max-width: 560px) {
		.marginalia {
			padding-top: 60px;
		}

		.page-heading {
			margin-bottom: 70px;
		}

		.scrapbook {
			display: flex;
			flex-direction: column;
			gap: 45px;
		}

		.scrap,
		.scrap.image,
		.scrap.quote,
		.scrap.note,
		.scrap.link {
			width: 100%;
		}
	}
</style>