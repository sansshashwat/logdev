---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="index" description="A small corner of the internet belonging to s. shashwat.">
	<section class="hero">
		<div class="hero-copy">
			<h1>s. shashwat<button class="dot-trigger" type="button" aria-label="A small game is hidden here" data-dot-trigger>.</button></h1>
			<p class="intro">A place for the things I think about,<br />the things I make, and the things I refuse to forget.</p>
		</div>

		<div class="dot-game" data-dot-game aria-hidden="true">
			<canvas data-game-canvas aria-label="A small pong game"></canvas>
			<p class="game-message" data-game-message>good job</p>
			<span class="game-hint">move to play / esc to leave</span>
		</div>
	</section>

	<section class="home-easter-eggs" aria-live="polite">
		<div class="egg egg-waiting" data-waiting>
			<span class="dots"><i></i><i></i><i></i></span>
			<span data-message></span>
		</div>

		<p class="egg egg-scroll egg-book">
			you remind me of someone who opens a book from the middle.
		</p>

		<p class="egg egg-scroll egg-here">
			still here?
		</p>

		<div class="music-player egg-scroll">
			<div class="player-main">
				<img
					class="record-art"
					src="/songs/thenewabnormal.jpg"
					alt="The New Abnormal album cover by The Strokes"
				/>

				<div class="track-info">
					<span class="eyebrow">a small offering</span>
					<strong>Selfless</strong>
					<small>The Strokes</small>
				</div>
			</div>

			<div class="player-controls">
				<button
					class="control-button"
					type="button"
					aria-label="Rewind 10 seconds"
					data-rewind
				>↶</button>

				<button
					class="play-button"
					type="button"
					aria-label="Play favourite song"
					data-play
				><span>▶</span></button>

				<button
					class="control-button"
					type="button"
					aria-label="Forward 10 seconds"
					data-forward
				>↷</button>
			</div>

			<div class="timeline-row">
				<span data-current-time>0:00</span>
				<input
					type="range"
					min="0"
					max="100"
					value="0"
					aria-label="Song progress"
					data-progress
				/>
				<span data-duration>0:00</span>
			</div>

			<a
				class="song-link"
				href="https://open.spotify.com/"
				target="_blank"
				rel="noreferrer"
				aria-label="Open song in Spotify"
			>open in spotify ↗</a>

			<audio data-audio preload="metadata" src="/songs/selfless.mp3"></audio>
		</div>
	</section>
</SiteLayout>

<style>
	.hero {
		min-height: calc(100vh - 96px);
		display: flex;
		align-items: center;
		position: relative;
		overflow: hidden;
	}

	.hero-copy {
		padding-bottom: 5vh;
		position: relative;
		z-index: 1;
		animation: rise 900ms ease both;
	}

	h1 {
		font-family: var(--serif);
		font-size: clamp(82px, 14vw, 210px);
		line-height: 0.82;
		font-weight: 400;
		letter-spacing: -0.055em;
		margin: 28px 0 36px;
	}

	h1 .dot-trigger {
		display: inline-block;
		appearance: none;
		border: 0;
		padding: 0;
		color: var(--accent);
		background: transparent;
		font: inherit;
		line-height: inherit;
		cursor: pointer;
		transition: transform 180ms ease, color 180ms ease, text-shadow 180ms ease;
	}

	h1 .dot-trigger:hover,
	h1 .dot-trigger:focus-visible {
		color: #e8b77f;
		transform: translateY(-5px) scale(1.12);
		text-shadow: 0 0 18px rgba(211, 162, 115, .55);
		outline: none;
	}

	.intro {
		color: var(--muted);
		line-height: 1.8;
		font-size: 14px;
		margin: 0;
	}

	.home-easter-eggs {
		min-height: 280vh;
		position: relative;
	}

	.egg {
		color: var(--muted);
		text-align: center;
		font-size: 11px;
		letter-spacing: .11em;
		text-transform: uppercase;
	}

	.egg-waiting {
		position: absolute;
		z-index: 6;
		top: 12vh;
		left: 50%;
		transform: translateX(-50%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 500ms ease;
		min-width: 250px;
	}

	.egg-waiting.is-visible {
		opacity: 1;
	}

	.dots {
		display: flex;
		justify-content: center;
		gap: 7px;
		margin-bottom: 14px;
	}

	.dots i {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent);
		animation: blink 1.1s infinite;
	}

	.dots i:nth-child(2) {
		animation-delay: .18s;
	}

	.dots i:nth-child(3) {
		animation-delay: .36s;
	}

	.egg-scroll {
		opacity: 0;
		transition: opacity 800ms ease, transform 800ms ease;
	}

	.egg-scroll.is-visible {
		opacity: 1;
	}

	.egg-book {
		position: absolute;
		top: 29%;
		width: 100%;
	}

	.egg-here {
		position: absolute;
		top: 56%;
		width: 100%;
	}

	.music-player {
		position: absolute;
		top: 92%;
		left: 50%;
		transform: translateX(-50%);
		width: min(100%, 570px);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding: 22px 0 18px;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 18px 22px;
		align-items: center;
	}

	.music-player.is-visible {
		transform: translateX(-50%);
	}

	.player-main {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.record-art {
		width: 72px;
		height: 72px;
		object-fit: cover;
		background: #c69361;
		color: #20231f;
		display: block;
		font-family: var(--serif);
		border-radius: 0;
	}

	.track-info {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.track-info strong {
		font-family: var(--serif);
		font-size: 25px;
		font-weight: 400;
	}

	.track-info small {
		color: var(--muted);
		font-size: 10px;
	}

	.player-controls {
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.control-button,
	.play-button {
		border: 1px solid var(--line);
		color: var(--ink);
		background: transparent;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		cursor: pointer;
		transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
	}

	.control-button {
		font-size: 17px;
		line-height: 1;
	}

	.play-button:hover,
	.play-button.is-playing,
	.control-button:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--deep);
	}

	.play-button span {
		font-size: 10px;
	}

	.timeline-row {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 34px 1fr 34px;
		align-items: center;
		gap: 10px;
		color: var(--faint);
		font-size: 10px;
	}

	.timeline-row input {
		width: 100%;
		accent-color: var(--accent);
		cursor: pointer;
	}

	.song-link {
		grid-column: 1 / -1;
		color: var(--faint);
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: .12em;
		transition: color 180ms ease;
	}

	.song-link:hover {
		color: var(--accent);
	}

	.dot-game {
		position: absolute;
		z-index: 2;
		inset: 0;
		display: none;
		background: transparent;
	}

	.dot-game.is-playing {
		display: block;
	}

	.dot-game canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.game-message {
		position: absolute;
		top: 50%;
		left: 72%;
		transform: translate(-50%, -50%);
		width: max-content;
		margin: 0;
		color: var(--accent);
		font-size: 11px;
		letter-spacing: .18em;
		text-align: center;
		text-transform: uppercase;
		opacity: 0;
		transition: opacity 300ms ease;
		pointer-events: none;
	}

	.game-message.is-visible {
		opacity: 1;
	}

	.game-hint {
		position: absolute;
		right: 22px;
		bottom: 22px;
		color: var(--faint);
		font-size: 9px;
		letter-spacing: .13em;
		text-transform: uppercase;
		pointer-events: none;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(24px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes blink {
		0%, 100% {
			opacity: .2;
		}

		50% {
			opacity: 1;
		}
	}

	@media (max-width: 620px) {
		.hero {
			min-height: calc(100vh - 78px);
		}

		h1 {
			font-size: clamp(72px, 23vw, 140px);
		}

		.egg-book {
			top: 25%;
			padding: 0 24px;
			line-height: 1.8;
		}

		.egg-here {
			top: 54%;
		}

		.music-player {
			top: 92%;
			grid-template-columns: 1fr;
			gap: 16px;
			padding: 16px 0;
		}

		.player-main {
			gap: 12px;
		}

		.record-art {
			width: 56px;
			height: 56px;
		}

		.track-info strong {
			font-size: 21px;
		}

		.player-controls {
			justify-content: center;
		}

		.song-link {
			display: block;
		}

		.game-message {
			left: 68%;
		}

		.game-hint {
			right: 12px;
			bottom: 14px;
		}
	}
</style>

<script>
	const waitingEgg = document.querySelector('[data-waiting]');
	const message = document.querySelector('[data-message]');
	const messages = [
		'hello there',
		"you've been here for a while",
		"there's...",
		"there's more to this than meets the eye."
	];

	const sleep = (time: number) =>
		new Promise((resolve) => setTimeout(resolve, time));

	async function revealMessages() {
		if (!message) return;

		await sleep(10000);
		waitingEgg?.classList.add('is-visible');

		await sleep(1600);

		for (const text of messages) {
			message.textContent = '';

			for (const letter of text) {
				message.textContent += letter;
				await sleep(82);
			}

			await sleep(2400);
			message.textContent = '';
			await sleep(1000);
		}

		waitingEgg?.classList.remove('is-visible');
	}

	revealMessages();

	const scrollEggs = document.querySelectorAll('.egg-scroll');

	const observer = new IntersectionObserver(
		(entries) =>
			entries.forEach(
				(entry) =>
					entry.isIntersecting &&
					entry.target.classList.add('is-visible')
			),
		{ threshold: 0.45 }
	);

	scrollEggs.forEach((egg) => observer.observe(egg));

	const audio = document.querySelector<HTMLAudioElement>('[data-audio]');
	const playButton = document.querySelector<HTMLButtonElement>('[data-play]');
	const progress = document.querySelector<HTMLInputElement>('[data-progress]');
	const currentTime = document.querySelector('[data-current-time]');
	const duration = document.querySelector('[data-duration]');

	const formatTime = (seconds: number) =>
		`${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;

	const updateProgress = () => {
		if (!audio) return;

		const length = Number.isFinite(audio.duration) ? audio.duration : 0;

		if (progress) {
			progress.max = String(length || 100);
			progress.value = String(audio.currentTime);
		}

		if (currentTime) currentTime.textContent = formatTime(audio.currentTime);
		if (duration) duration.textContent = formatTime(length);
	};

	playButton?.addEventListener('click', () => {
		if (!audio) return;

		if (audio.paused) {
			audio.play().catch(() => undefined);
		} else {
			audio.pause();
		}
	});

	document
		.querySelector<HTMLButtonElement>('[data-rewind]')
		?.addEventListener('click', () => {
			if (audio) audio.currentTime = Math.max(0, audio.currentTime - 10);
		});

	document
		.querySelector<HTMLButtonElement>('[data-forward]')
		?.addEventListener('click', () => {
			if (audio) {
				audio.currentTime = Math.min(
					audio.duration || 0,
					audio.currentTime + 10
				);
			}
		});

	progress?.addEventListener('input', () => {
		if (audio) audio.currentTime = Number(progress.value);
	});

	audio?.addEventListener('timeupdate', updateProgress);
	audio?.addEventListener('loadedmetadata', updateProgress);

	audio?.addEventListener('play', () => {
		playButton?.classList.add('is-playing');

		if (playButton) {
			playButton.setAttribute('aria-label', 'Pause favourite song');
		}

		const icon = playButton?.querySelector('span');

		if (icon) icon.textContent = 'Ⅱ';
	});

	audio?.addEventListener('pause', () => {
		playButton?.classList.remove('is-playing');

		if (playButton) {
			playButton.setAttribute('aria-label', 'Play favourite song');
		}

		const icon = playButton?.querySelector('span');

		if (icon) icon.textContent = '▶';
	});

	updateProgress();

	const dotTrigger =
		document.querySelector<HTMLButtonElement>('[data-dot-trigger]');

	const dotGame =
		document.querySelector<HTMLElement>('[data-dot-game]');

	const gameCanvas =
		document.querySelector<HTMLCanvasElement>('[data-game-canvas]');

	const gameMessage =
		document.querySelector('[data-game-message]');

	const gameContext = gameCanvas?.getContext('2d');

	let dotClicks = 0;
	let gameFrame = 0;
	let gameRunning = false;
	let paddleX = 0;
	let ballX = 0;
	let ballY = 0;
	let ballVelocityX = 250;
	let ballVelocityY = -250;
	let ballSpeed = 250;

	const paddleWidth = 160;
	const paddleHeight = 3;

	let ballRadius = 15;
	let gameWidth = 0;
	let gameHeight = 0;
	let gameScale = 1;
	let lastFrameTime = 0;

	const resizeGame = () => {
		if (!gameCanvas) return;

		const bounds = gameCanvas.getBoundingClientRect();

		gameScale = window.devicePixelRatio || 1;
		gameWidth = bounds.width;
		gameHeight = bounds.height;

		gameCanvas.width = Math.round(gameWidth * gameScale);
		gameCanvas.height = Math.round(gameHeight * gameScale);

		gameContext?.setTransform(gameScale, 0, 0, gameScale, 0, 0);

		const periodBounds = dotTrigger?.getBoundingClientRect();

		if (periodBounds) {
			ballRadius = Math.max(
				8,
				Math.min(14, periodBounds.width * .22)
			);
		}

		paddleX = Math.max(
			0,
			Math.min(gameWidth - paddleWidth, paddleX)
		);
	};

	const drawGame = () => {
		if (!gameCanvas || !gameContext) return;

		const width = gameWidth;
		const height = gameHeight;

		gameContext.clearRect(0, 0, width, height);

		gameContext.fillStyle = '#d3a273';
		gameContext.fillRect(
			paddleX,
			height - 72,
			paddleWidth,
			paddleHeight
		);

		gameContext.beginPath();
		gameContext.arc(
			ballX,
			ballY,
			ballRadius,
			0,
			Math.PI * 2
		);
		gameContext.fill();
	};

	const endGame = () => {
		gameRunning = false;
		cancelAnimationFrame(gameFrame);

		gameMessage?.classList.add('is-visible');

		const target = dotTrigger?.getBoundingClientRect();
		const canvasBounds = gameCanvas?.getBoundingClientRect();

		const startX = ballX;
		const startY = ballY;

		const targetX =
			target && canvasBounds
				? target.left - canvasBounds.left + target.width / 2
				: gameWidth / 2;

		const targetY =
			target && canvasBounds
				? target.top - canvasBounds.top + target.height / 2
				: 80;

		const landingY = Math.max(55, targetY - 105);

		window.setTimeout(() => {
			const returnStarted = performance.now();

			const returnBall = (now: number) => {
				const progress = Math.min(
					1,
					(now - returnStarted) / 850
				);

				const eased =
					progress < .5
						? 4 * progress * progress * progress
						: 1 - Math.pow(-2 * progress + 2, 3) / 2;

				ballX = startX + (targetX - startX) * eased;
				ballY = startY + (landingY - startY) * eased;

				drawGame();

				if (progress < 1) {
					requestAnimationFrame(returnBall);
				} else {
					const dropStarted = performance.now();

					const dropBall = (dropNow: number) => {
						const dropProgress = Math.min(
							1,
							(dropNow - dropStarted) / 480
						);

						const dropEased =
							dropProgress *
							dropProgress *
							(3 - 2 * dropProgress);

						ballX = targetX;
						ballY =
							landingY +
							(targetY - landingY) * dropEased;

						drawGame();

						if (dropProgress < 1) {
							requestAnimationFrame(dropBall);
						} else {
							ballX = targetX;
							ballY = targetY;

							drawGame();

							window.setTimeout(() => {
								gameMessage?.classList.remove(
									'is-visible'
								);

								dotGame?.classList.remove(
									'is-playing'
								);

								dotGame?.setAttribute(
									'aria-hidden',
									'true'
								);

								dotTrigger?.focus();
							}, 900);
						}
					};

					requestAnimationFrame(dropBall);
				}
			};

			requestAnimationFrame(returnBall);
		}, 1500);
	};

	const gameLoop = (timestamp: number) => {
		if (!gameCanvas || !gameRunning) return;

		const delta = Math.min(
			(timestamp - lastFrameTime) / 1000,
			.032
		);

		lastFrameTime = timestamp;

		const width = gameWidth;
		const height = gameHeight;

		ballX += ballVelocityX * delta;
		ballY += ballVelocityY * delta;

		if (
			ballX - ballRadius <= 0 ||
			ballX + ballRadius >= width
		) {
			ballVelocityX *= -1;

			ballX = Math.max(
				ballRadius,
				Math.min(width - ballRadius, ballX)
			);
		}

		if (ballY - ballRadius <= 0) {
			ballVelocityY = Math.abs(ballVelocityY);
			ballY = ballRadius;
		}

		const paddleY = height - 72;

		if (
			ballY + ballRadius >= paddleY &&
			ballY < height &&
			ballX >= paddleX &&
			ballX <= paddleX + paddleWidth
		) {
			const paddleOffset =
				(ballX - (paddleX + paddleWidth / 2)) /
				(paddleWidth / 2);

			ballSpeed = Math.min(700, ballSpeed + 20);

			const reboundAngle =
				paddleOffset * 0.85 +
				(Math.random() - 0.5) * 0.22;

			ballVelocityX =
				Math.sin(reboundAngle) * ballSpeed;

			ballVelocityY =
				-Math.cos(reboundAngle) * ballSpeed;

			ballY = paddleY - ballRadius;
		}

		if (ballY - ballRadius > height) {
			endGame();
			return;
		}

		drawGame();
		gameFrame = requestAnimationFrame(gameLoop);
	};

	const startGame = () => {
		if (!gameCanvas || !dotGame) return;

		dotGame.classList.add('is-playing');
		dotGame.setAttribute('aria-hidden', 'false');

		resizeGame();

		paddleX = (gameWidth - paddleWidth) / 2;
		ballX = gameWidth / 2;
		ballY = gameHeight * .35;

		ballSpeed = 250;
		ballVelocityX = 250;
		ballVelocityY = -250;

		lastFrameTime = performance.now();
		gameRunning = true;

		gameMessage?.classList.remove('is-visible');

		gameFrame = requestAnimationFrame(gameLoop);
	};

	dotTrigger?.addEventListener('click', () => {
		dotClicks += 1;

		if (dotClicks >= 3) {
			dotClicks = 0;
			startGame();
		}
	});

	gameCanvas?.addEventListener('pointermove', (event) => {
		const bounds = gameCanvas.getBoundingClientRect();

		paddleX = Math.max(
			0,
			Math.min(
				gameWidth - paddleWidth,
				event.clientX -
					bounds.left -
					paddleWidth / 2
			)
		);
	});

	window.addEventListener('keydown', (event) => {
		if (!gameRunning || !gameCanvas) return;

		if (
			event.key === 'ArrowLeft' ||
			event.key === 'ArrowRight'
		) {
			event.preventDefault();

			paddleX +=
				event.key === 'ArrowLeft' ? -28 : 28;

			paddleX = Math.max(
				0,
				Math.min(
					gameWidth - paddleWidth,
					paddleX
				)
			);
		}

		if (event.key === 'Escape') endGame();
	});

	window.addEventListener('resize', resizeGame);
</script>