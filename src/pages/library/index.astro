---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const posts = await getCollection('blogs');

const sortedPosts = posts.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const getReadingTime = (body: string | undefined) => {
	if (!body) return '1 min read';

	const words = body.trim().split(/\s+/).length;
	const minutes = Math.max(1, Math.ceil(words / 200));

	return `${minutes} min read`;
};

const formatDate = (date: Date) => {
	return date
		.toLocaleDateString('en-GB', {
			day: '2-digit',
			month: '2-digit',
			year: '2-digit',
		})
		.replaceAll('/', '.');
};
---

<SiteLayout title="library" description="Essays and notes by s. shashwat.">
	<section class="library-heading">
		<div>
        <h1>library<span>.</span></h1>
       </div>

		<p class="heading-note">
			sometimes i need a backspace key
		</p>
	</section>

	<section class="essay-list" aria-label="Essays">
		{sortedPosts.map((post, index) => (
			<a class="essay" href={`/library/${post.id}/`}>
				<span class="essay-number">
					{String(index + 1).padStart(2, '0')}
				</span>

				<div class="essay-main">
					<h2>{post.data.title}</h2>

					{post.data.description && (
						<p>{post.data.description}</p>
					)}
				</div>

				<div class="essay-meta">
					<span>{formatDate(post.data.date)}</span>
					<span>{getReadingTime(post.body)}</span>
					<span class="arrow">↗</span>
				</div>
			</a>
		))}
	</section>

	{sortedPosts.length === 0 && (
		<p class="empty-library">
			nothing here yet.
		</p>
	)}

	<p class="playlist-note">
		looking for more songs?
		<a
			href="https://open.spotify.com/"
			target="_blank"
			rel="noreferrer"
		>
			step this way <span>↗</span>
		</a>
	</p>
</SiteLayout>

<style>
	.library-heading {
		min-height: 45vh;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		padding: 60px 0 78px;
		border-bottom: 1px solid var(--line);
	}

	.library-heading h1 {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(75px, 13vw, 180px);
		line-height: .78;
		letter-spacing: -.05em;
		margin: 31px 0 0 -0.05em;
	}

	.library-heading h1 span {
		color: var(--accent);
	}

	.heading-note {
		color: var(--muted);
		font-size: 13px;
		line-height: 1.8;
		margin: 0 0 5px;
	}

	.essay {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr) 210px;
		gap: 20px;
		align-items: start;
		padding: 33px 0 36px;
		border-bottom: 1px solid var(--line);
		transition: padding 250ms ease, color 250ms ease;
	}

	.essay:hover {
		padding-left: 18px;
		color: var(--accent);
	}

	.essay-number,
	.essay-meta {
		color: var(--faint);
		font-size: 10px;
		letter-spacing: .13em;
	}

	.essay-main h2 {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(25px, 3vw, 38px);
		letter-spacing: -.02em;
		margin: -5px 0 10px;
	}

	.essay-main p {
		color: var(--muted);
		font-size: 12px;
		margin: 0;
		max-width: 460px;
		line-height: 1.7;
	}

	.essay-meta {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		padding-top: 4px;
		text-transform: uppercase;
	}

	.arrow {
		color: var(--accent);
		font-size: 16px;
		transition: transform 180ms ease;
	}

	.essay:hover .arrow {
		transform: translate(4px, -4px);
	}

	.empty-library {
		color: var(--faint);
		text-align: center;
		font-size: 11px;
		letter-spacing: .12em;
		text-transform: uppercase;
		padding: 80px 0;
	}

	.playlist-note {
		text-align: center;
		color: var(--faint);
		font-size: 10px;
		letter-spacing: .12em;
		text-transform: uppercase;
		padding-top: 150px;
	}

	.playlist-note a {
		color: var(--accent);
		margin-left: 5px;
	}

	.playlist-note a:hover span {
		display: inline-block;
		transform: translate(3px, -3px);
	}

	@media (max-width: 620px) {
		.library-heading {
			min-height: 40vh;
			display: block;
			padding-top: 90px;
		}

		.heading-note {
			margin-top: 35px;
		}

		.essay {
			grid-template-columns: 30px 1fr;
			gap: 8px;
			padding: 26px 0;
		}

		.essay-meta {
			grid-column: 2;
			gap: 14px;
			justify-content: flex-start;
		}

		.essay-main h2 {
			font-size: 29px;
		}

		.essay-main p {
			line-height: 1.6;
		}

		.playlist-note {
			padding-top: 100px;
		}
	}
</style>
